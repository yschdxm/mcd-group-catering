# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# 但 dist/ 里的说明与封面上库,便于他人知道产物如何重建
# (具体哪些大文件被排除,看 dist/.gitignore)
!dist/
!dist/README.md
!dist/.gitignore
!dist/*.png
.venv/
venv/
env/

# 测试与缓存
.pytest_cache/
.coverage
htmlcov/

# 本地敏感文件:绝对不要提交任何含真实 Token 的文件
.env
.env.*
!.env.example
*.local
token.txt
secrets.json

# 运行产物(示例输出除外)
probe-report.json
plan.json
proposal.md
*.local.json
!examples/*.json
!examples/*.md

# 临时提交信息文件
_msg.txt

# 临时文件(提交信息草稿、探针输出等)
_*.txt
_*.json
