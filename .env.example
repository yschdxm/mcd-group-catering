# 复制为 .env 并按需修改;真正的 Token 只放在环境变量里,切勿提交到仓库
# 申请地址:https://open.mcd.cn/mcp (登录 → 控制台 → 激活)

# 必填:麦当劳 MCP Token
MCD_MCP_TOKEN=your_mcd_mcp_token_here

# 可选:MCP 接入地址(默认 https://mcp.mcd.cn)
MCD_MCP_ENDPOINT=https://mcp.mcd.cn

# 可选:默认门店编码(可在 plan/menu 命令中用 --store 覆盖)
MCD_STORE_CODE=

# 可选:团餐/外送/得来速场景的业务编码(由门店接口返回,可在此固定)
MCD_BE_CODE=

# 可选:默认配送地址 ID(由 delivery-query-addresses 返回)
MCD_ADDRESS_ID=

# 可选:离线快照目录(默认仓库内 fixtures/)
MCD_FIXTURES=
